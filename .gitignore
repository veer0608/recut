.venv/
__pycache__/
*.pyc
.env
out/
.pytest_cache/
*.egg-info/
recut.db
*.db

# Ingested source text, cached so a before and after measurement compares the
# same input. Derived, third-party, and re-fetchable: not ours to check in.
eval/.cache/

# Tracebacks from a source that failed mid-run. Useful while diagnosing, and
# superseded by the failure list the report already carries.
eval/results/*/sources/*.error.txt

# Judge progress part-way through a source. Useful only until that source
# completes, and deleted when it does.
eval/results/*/partial/
