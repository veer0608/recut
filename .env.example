# Either key alone is enough.

# Primary. Model ids are pinned in recut/llm.py and walked as a ladder, because
# free-tier quota is per model. Never switch those to a -latest alias: they
# repoint to the newest model, which carries the smallest allowance.
GEMINI_API_KEY=

# Fallback. The binding limit is tokens per day and it appears in no response
# header, so a small probe succeeding proves nothing about the day's budget.
GROQ_API_KEY=
